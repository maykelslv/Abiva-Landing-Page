---
const features = [
  {
    label: "Trusted Content",
    title: "Abiva's Textbooks, Digitized",
    desc: "Access Ladders to Learning, Real-Life Science, ALAB sa Filipino, SRA Reading Lab, and more — the books Filipino classrooms have relied on for decades, now interactive on your device.",
    accent: "#2196F3",
    // Book Icon
    iconPath:
      "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
  },
  {
    label: "Curriculum Aligned",
    title: "DepEd-Accredited Coverage",
    desc: "Every lesson follows the official K–12 curriculum across all subjects and grade levels, from Preschool through Senior High School, so students always stay on track.",
    accent: "#1565C0",
    iconPath:
      "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
  {
    label: "Educator Tools",
    title: "Built for Filipino Teachers",
    desc: "In-app teacher's manuals, lesson guides, and professional development resources aligned with Abiva's decades-long commitment to educator support.",
    accent: "#2196F3",
    iconPath:
      "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
  },
  {
    label: "Always Available",
    title: "Offline & Rural Ready",
    desc: "Designed for every corner of the Philippines. Download lessons and study anytime, anywhere — no internet connection required.",
    accent: "#1565C0",
    iconPath:
      "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z",
  },
  {
    label: "Family Visibility",
    title: "Real-Time Progress Tracking",
    desc: "Parents and teachers get clear, at-a-glance insights into performance, completion rates, and learning milestones as they happen.",
    accent: "#2196F3",
    // Trending Chart Icon
    iconPath: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
  },
  {
    label: "Our Foundation",
    title: "Create. Associate. Innovate.",
    desc: "Built on Abiva's three core pillars — developing quality educational materials, forging world-class partnerships, and embracing the future of Philippine education.",
    accent: "#1565C0",
    // Sparkles Icon
    iconPath:
      "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
  },
];
---

<section id="features" class="px-6 md:px-16 py-24">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-2xl mb-16">
      <p
        class="text-xs font-bold tracking-[0.15em] uppercase text-sky-brand mb-3"
      >
        Why Abiva App
      </p>
      <h2
        class="font-display text-3xl md:text-4xl lg:text-[44px] font-black text-ink leading-tight mb-4"
      >
        90 years of expertise,<br />now in your hands.
      </h2>
      <p class="text-base md:text-lg text-muted leading-relaxed">
        The same quality Abiva has delivered since 1936 — reimagined for the
        modern Filipino learner.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        features.map(({ label, title, desc, accent, iconPath }, i) => (
          <div
            class="fade-up group relative bg-white border border-gray-100 rounded-3xl p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-sky-brand/20"
            style={`transition-delay:${i * 60}ms`}
          >
            <div
              class="absolute top-0 left-8 right-8 h-[2px] rounded-b-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              style={`background:${accent}`}
            />

            <div
              class="w-14 h-14 rounded-2xl flex items-center justify-center mb-8 shadow-sm transition-transform duration-300 group-hover:scale-110"
              style={`background-color: ${accent}1A; color: ${accent};`}
            >
              <svg
                class="w-7 h-7"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={iconPath}
                />
              </svg>
            </div>

            <p
              class="text-[10px] font-bold tracking-[0.15em] uppercase mb-3"
              style={`color:${accent}`}
            >
              {label}
            </p>
            <h3 class="font-bold text-lg text-ink mb-3 leading-snug">
              {title}
            </h3>
            <p class="text-sm text-muted leading-relaxed">{desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
