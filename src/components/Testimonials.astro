---
const testimonials = [
  {
    quote: "Abiva's textbooks have been my go-to since I started teaching. Having the teacher's manual and Ladders to Learning digitized in one app is a genuine game changer for my classroom.",
    name: "Ma'am Santos",
    role: "Grade 4 Teacher · Quezon City",
    initial: "S",
    accent: "#2196F3",
  },
  {
    quote: "I can review my ALAB sa Filipino lessons right on my phone. The interactive exercises make understanding the material so much easier than reading the textbook alone.",
    name: "Kyla Reyes",
    role: "Grade 9 Student · Cebu City",
    initial: "K",
    accent: "#FFC107",
    dark: true,
  },
  {
    quote: "We've trusted Abiva for our children's schooling for years. Knowing the app comes from the same publisher gives me complete confidence in what they're learning.",
    name: "Mr. dela Cruz",
    role: "Parent of three · Davao City",
    initial: "D",
    accent: "#1565C0",
  },
  {
    quote: "The offline mode is a lifesaver for our students in rural areas. They can download modules and continue learning even without stable internet — Abiva thought of everyone.",
    name: "Sir Mendoza",
    role: "School Principal · Isabela",
    initial: "M",
    accent: "#2196F3",
  },
  {
    quote: "My daughter actually asks to use the app now. The gamified lessons make her feel like she's playing while she's actually reviewing for exams. Incredible.",
    name: "Mrs. Reyes",
    role: "Parent · Makati City",
    initial: "R",
    accent: "#F44336",
  },
  {
    quote: "As a teacher, having DepEd-aligned digital content from Abiva in one place saves me hours of lesson planning every week. This app is long overdue.",
    name: "Ma'am Garcia",
    role: "Grade 6 Teacher · Cebu City",
    initial: "G",
    accent: "#1565C0",
  },
];
---

<section id="testimonials" class="bg-white py-24 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-16">
    <!-- Section header -->
    <div class="max-w-2xl mb-14">
      <p class="text-xs font-bold tracking-[0.15em] uppercase text-sky-brand mb-3">Early Feedback</p>
      <h2 class="font-display text-3xl md:text-4xl lg:text-[44px] font-black text-ink leading-tight mb-4">
        Trusted by Filipino families<br />for generations.
      </h2>
      <p class="text-base md:text-lg text-muted leading-relaxed">
        Beta users — teachers, students, and parents — share their experience with the Abiva App.
      </p>
    </div>
  </div>

  <!-- Infinite scroll carousel -->
  <div class="relative">
    <!-- Fade edges -->
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-24 z-10 bg-gradient-to-r from-white to-transparent"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-24 z-10 bg-gradient-to-l from-white to-transparent"></div>

    <!-- Track -->
    <div class="carousel-track flex gap-5 w-max">
      {[...testimonials, ...testimonials].map(({ quote, name, role, initial, accent }, i) => (
        <div
          class="carousel-card flex-shrink-0 w-[320px] bg-white border border-gray-100 rounded-2xl p-7 shadow-[0_2px_16px_rgba(13,27,42,0.06)] flex flex-col"
        >
          <!-- Stars -->
          <div class="flex gap-0.5 mb-4">
            {[...Array(5)].map(() => (
              <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="#FFC107">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-sm text-[#37474F] leading-[1.8] mb-5 flex-1">
            "{quote}"
          </blockquote>

          <!-- Author -->
          <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
            <div
              class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 text-white"
              style={`background:${accent}`}
            >
              {initial}
            </div>
            <div>
              <strong class="block text-sm font-semibold text-ink leading-tight">{name}</strong>
              <span class="text-xs text-muted">{role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .carousel-track {
    animation: scroll-left 35s linear infinite;
    padding: 1rem 6rem;
  }

  .carousel-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-left {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
