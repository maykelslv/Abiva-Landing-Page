---

---

<section id="download" class="bg-[#F8FAFC] px-6 md:px-16 py-24">
  <div class="max-w-7xl mx-auto">
    <!-- Section wrapper: text left, download card right -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left: copy -->
      <div class="fade-up">
        <p
          class="text-xs font-bold tracking-[0.15em] uppercase text-sky-brand mb-3"
        >
          Download the App
        </p>
        <h2
          class="font-display text-3xl md:text-4xl lg:text-[44px] font-black text-ink leading-tight mb-5"
        >
          Start learning<br />in minutes.
        </h2>
        <p
          class="text-base md:text-lg text-muted leading-relaxed mb-8 max-w-lg"
        >
          Scan the QR code or tap a badge below to download the Abiva App on
          your iPhone or Android device — and bring 88 years of Philippine
          educational excellence to your pocket.
        </p>

        <!-- Trust badges -->
        <div class="flex flex-wrap gap-6">
          <div class="flex items-center gap-2">
            <div
              class="w-8 h-8 rounded-full bg-sky-pale flex items-center justify-center"
            >
              <svg
                class="w-4 h-4 text-sky-brand"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-sm font-semibold text-muted"
              >Free to Download</span
            >
          </div>
          <div class="flex items-center gap-2">
            <div
              class="w-8 h-8 rounded-full bg-sky-pale flex items-center justify-center"
            >
              <svg
                class="w-4 h-4 text-sky-brand"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-sm font-semibold text-muted"
              >DepEd-Aligned Content</span
            >
          </div>
          <div class="flex items-center gap-2">
            <div
              class="w-8 h-8 rounded-full bg-sky-pale flex items-center justify-center"
            >
              <svg
                class="w-4 h-4 text-sky-brand"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-sm font-semibold text-muted">Works Offline</span>
          </div>
        </div>
      </div>

      <!-- Right: download card -->
      <div
        class="fade-up [transition-delay:150ms] flex justify-center lg:justify-end"
      >
        <div
          class="bg-white border border-gray-100 rounded-2xl shadow-[0_4px_32px_rgba(13,27,42,0.08)] p-8 md:p-10 w-full max-w-sm"
        >
          <p
            class="text-xs font-bold tracking-[0.15em] uppercase text-muted mb-6"
          >
            Scan to Download
          </p>

          <!-- QR code placeholder — replace src with real QR -->
          <div class="flex gap-6 items-start mb-8">
            <div
              class="bg-white border border-gray-200 rounded-xl p-2 flex-shrink-0 shadow-sm"
            >
              <img
                src="/abiva-qr.png"
                alt="Scan QR code to download Abiva App"
                class="w-28 h-28 object-contain"
              />
            </div>

            <!-- Instructions -->
            <div class="pt-1">
              <p class="text-sm font-semibold text-ink mb-1">
                Point your camera
              </p>
              <p class="text-xs text-muted leading-relaxed">
                Open your phone camera and point it at the QR code to go
                directly to the app.
              </p>
            </div>
          </div>

          <!-- Divider -->
          <div class="flex items-center gap-3 mb-6">
            <div class="flex-1 h-px bg-gray-100"></div>
            <span class="text-xs font-semibold text-muted"
              >or download directly</span
            >
            <div class="flex-1 h-px bg-gray-100"></div>
          </div>

          <!-- Store badges -->
          <div class="flex flex-col gap-3">
            <a
              href="#"
              class="flex items-center gap-4 bg-ink hover:bg-[#1a2a3a] text-white rounded-xl px-5 py-3.5 transition-all duration-200 hover:-translate-y-px hover:shadow-[0_6px_20px_rgba(13,27,42,0.3)] group"
            >
              <svg
                class="w-7 h-7 flex-shrink-0"
                viewBox="0 0 814 1000"
                fill="white"
              >
                <path
                  d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-57.8-155.5-127.4C46 790.7 0 663 0 541.8c0-207.3 143.8-317.1 284.8-317.1 75.5 0 138.3 49.9 184.5 49.9 44.4 0 114.1-52.7 201.4-52.7 32.3-.1 127.9 5.8 198.5 95.1zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
                ></path>
              </svg>
              <div>
                <p
                  class="text-[10px] font-semibold text-white/60 leading-none mb-0.5"
                >
                  Download on the
                </p>
                <p class="text-base font-bold leading-none">App Store</p>
              </div>
            </a>

            <a
              href="#"
              class="flex items-center gap-4 bg-ink hover:bg-[#1a2a3a] text-white rounded-xl px-5 py-3.5 transition-all duration-200 hover:-translate-y-px hover:shadow-[0_6px_20px_rgba(13,27,42,0.3)] group"
            >
              <img
                src="/playstore.png"
                alt="Google Play Icon"
                class="w-7 h-7 flex-shrink-0 object-contain"
              />
              <div>
                <p
                  class="text-[10px] font-semibold text-white/60 leading-none mb-0.5"
                >
                  Get it on
                </p>
                <p class="text-base font-bold leading-none">Google Play</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
