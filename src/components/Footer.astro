<footer class="bg-ink text-white px-6 md:px-16 pt-16 pb-10">
  <div class="max-w-7xl mx-auto">

    <!-- Top row -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-white/8">

      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <img src="/abiva-logo.png" alt="Abiva" class="h-9 w-auto brightness-0 invert opacity-80" />
          <div>
            <span class="font-display font-black text-base block leading-tight">Abiva Publishing House, Inc.</span>
          </div>
        </div>
        <p class="text-sm text-white/45 leading-relaxed max-w-sm">
          Pioneering Philippine education since 1936. Developing nation builders and global leaders — one learner at a time.
        </p>
        <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-white/25 mt-4">
          Quality Education is our Mission
        </p>
      </div>

      <!-- App -->
      <div>
        <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-white/35 mb-4">Abiva App</p>
        <div class="flex flex-col gap-2.5">
          <a href="#features" class="text-sm text-white/50 hover:text-white transition-colors">Features</a>
          <a href="#audience" class="text-sm text-white/50 hover:text-white transition-colors">Who It's For</a>
          <a href="#testimonials" class="text-sm text-white/50 hover:text-white transition-colors">Reviews</a>
          <a href="#download" class="text-sm text-white/50 hover:text-white transition-colors">Download</a>
        </div>
      </div>

      <!-- Abiva -->
      <div>
        <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-white/35 mb-4">Abiva</p>
        <div class="flex flex-col gap-2.5">
          <a href="https://abiva.com.ph/about_us/" target="_blank" rel="noopener" class="text-sm text-white/50 hover:text-white transition-colors">About Us</a>
          <a href="https://abiva.com.ph/catalog/" target="_blank" rel="noopener" class="text-sm text-white/50 hover:text-white transition-colors">e-Catalog</a>
          <a href="https://abiva-publishing.myshopify.com/" target="_blank" rel="noopener" class="text-sm text-white/50 hover:text-white transition-colors">Online Store</a>
          <a href="https://abiva.com.ph/contact-us/" target="_blank" rel="noopener" class="text-sm text-white/50 hover:text-white transition-colors">Contact Us</a>
        </div>
      </div>

    </div>

    <!-- Bottom row -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-8">
      <p class="text-xs text-white/30">
        © 2026 Abiva Publishing House, Inc. All rights reserved.
      </p>
      <div class="flex gap-5">
        <a href="#" class="text-xs text-white/30 hover:text-white/60 transition-colors">Privacy Policy</a>
        <a href="#" class="text-xs text-white/30 hover:text-white/60 transition-colors">Terms of Use</a>
      </div>
    </div>

  </div>
